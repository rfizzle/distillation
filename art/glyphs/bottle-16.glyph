# distillation — potion-bottle glyph, 16×16 (Jade/WTHIT & recipe-viewer contexts; no HUD slot)
# Palette maps to design/DESIGN.md: Potion Magenta #C44DCC, Elixir #DA79E3,
# Glass #AFC6CE, Copper #E77C56 (cork). distillation.* tokens are not yet
# registered in the concord glyph palette — hex used with the DESIGN.md role
# named beside each entry.
size: 16

legend:
  . transparent
  K ink            # #0a0a0a outline
  m #c44dcc        # Potion Magenta — liquid body
  e #da79e3        # Elixir — meniscus rim, glow core, vapor wisp
  g #afc6ce        # Glass — pale glass highlight
  c #e77c56        # Copper — cork stopper

frame:
