# Flask item sprite (SPEC §12) — a copper-and-glass round-bottomed vessel with a
# copper collar and stopper, hollow bulb so the tinted liquid layer shows through
# on the filled model. 3-tone ramps over two base hues (copper, glass) + ink.
size: 16
kind: sprite
ships: src/main/resources/assets/distillation/textures/item/flask.png

legend:
  . transparent
  K ink                    # #0a0a0a outline
  c distillation.copper    # #e77c56 copper midtone
  C #f4ac89                # copper highlight
  v #b05a38                # copper shadow
  g distillation.glass     # #afc6ce glass midtone
  G #d8e6ec                # glass highlight
  s #7f98a1                # glass shadow

grid:
  .......KK.......
  ......KCcK......
  ......KcvK......
  ......KGsK......
  .....KcCCcK.....
  ....KGg..gGK....
  ...KGg....gGK...
  ..KGg......gGK..
  ..KGs......sGK..
  ..KGs......sGK..
  ..KGs......sGK..
  ...KGs....sGK...
  ....KGssssGK....
  .....KssssK.....
  ......KKKK......
  ................
