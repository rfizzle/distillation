# Flask liquid overlay (SPEC §12) — the fill that sits inside the flask bulb on the
# filled model, tinted in code to the stored brew's color (an item ColorProvider on
# tintIndex 1). Light greyscale so the multiply tint reads true, with a brighter
# surface line and a shaded base for a little depth. Shape stays within the vessel's
# hollow interior so the glass walls read around it.
size: 16

legend:
  . transparent
  H #eae4d6   # surface highlight
  L #d6cfbe   # liquid body (light, tints true)
  l #b7ae9b   # liquid mid
  m #948b78   # liquid base shadow

grid:
  ................
  ................
  ................
  ................
  ................
  ................
  ................
  .....HHHHHH.....
  .....LLLLLL.....
  .....LlLLlL.....
  .....LllllL.....
  ......mllm......
  ......mllm......
  .......mm.......
  ................
  ................
