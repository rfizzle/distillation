# distillation — Recipe Note item, 16×16 (design/DESIGN.md §3: a copied brewing
# recipe on parchment). Shares murky_draught's ink outline so the item family
# reads together. Light from top-left: bone highlight on the left/top, ash mid,
# smoke occlusion at the bottom-right. A folded copper dog-ear at the top-right,
# grey-ink writing lines, and one Potion Magenta wax seal (bottom-left) mark it
# as a brewing recipe. Palette maps to DESIGN.md roles named beside each entry.
size: 16
kind: sprite
ships: src/main/resources/assets/distillation/textures/item/recipe_note.png

legend:
  . transparent
  K ink                    # #0a0a0a outline
  p bone                   # parchment highlight (toward light)
  a ash                    # parchment midtone
  s smoke                  # parchment occlusion (away from light)
  w #33302a                # grey-ink writing stroke
  m distillation.magenta   # wax seal body
  M distillation.elixir    # wax seal highlight
  c distillation.copper    # folded dog-ear (lit face)
  C #b85c3e                # Copper shadow — fold underside

frame:
  ................
  ...KKKKKKKKKK...
  ...KpppppccCK...
  ...KpwwwppcCK...
  ...KppppppaCK...
  ...KpwwwwpaaK...
  ...KppppppaaK...
  ...KpwwwwwaaK...
  ...KppppppaaK...
  ...KpwwwwpaaK...
  ...KppppppaaK...
  ...KmMpwwpaaK...
  ...KMmppppasK...
  ...KpppppassK...
  ...KKKKKKKKKK...
  ................
