{
    "schemaVersion": 1,
    "id": "distillation",
    "version": "${version}",
    "name": "Distillation",
    "description": "An alchemy overhaul for Minecraft. The brewing stand teaches its own recipes, every vanilla effect becomes brewable, known recipes batch to six bottles over a heated cauldron, utility potions last honest durations, and antidotes cure one affliction at a time.",
    "authors": ["rfizzle"],
    "contact": {
        "homepage": "https://distillation.rfizzle.com",
        "sources": "https://github.com/rfizzle/distillation",
        "issues": "https://github.com/rfizzle/distillation/issues"
    },
    "license": "MIT",
    "icon": "assets/distillation/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.rfizzle.distillation.Distillation"],
        "client": ["com.rfizzle.distillation.client.DistillationClient"],
        "modmenu": ["com.rfizzle.distillation.compat.modmenu.ModMenuIntegration"],
        "fabric-gametest": [
            "com.rfizzle.distillation.gametest.SmokeGameTest",
            "com.rfizzle.distillation.gametest.MissingBrewsGameTest",
            "com.rfizzle.distillation.gametest.RecipeGraphGameTest",
            "com.rfizzle.distillation.gametest.DiscoveryGameTest",
            "com.rfizzle.distillation.gametest.DistillationCommandGameTest",
            "com.rfizzle.distillation.gametest.MurkyDraughtGameTest",
            "com.rfizzle.distillation.gametest.BatchBrewingGameTest",
            "com.rfizzle.distillation.gametest.DraughtGameTest",
            "com.rfizzle.distillation.gametest.PremiumBrewsGameTest",
            "com.rfizzle.distillation.gametest.AntidoteGameTest",
            "com.rfizzle.distillation.gametest.ThrownRebalanceGameTest",
            "com.rfizzle.distillation.gametest.AdvancementGameTest"
        ]
    },
    "suggests": {
        "modmenu": "*",
        "cloth-config": "*",
        "jade": "*",
        "wthit": "*",
        "emi": "*",
        "roughlyenoughitems": "*",
        "jei": "*",
        "tribulation": "*"
    },
    "mixins": [
        "distillation.mixins.json",
        {
            "config": "distillation.client.mixins.json",
            "environment": "client"
        }
    ],
    "accessWidener": "distillation.accesswidener",
    "depends": {
        "fabricloader": ">=0.16.10",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    }
}
